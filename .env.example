# Copy to .env.local for development. Never commit real values; never paste them into
# docs, issues or logs. Production values live only in Vercel (Production scope) and Supabase.
# Use a *separate* Supabase project (not production) for Preview/Development — see
# docs/pick8-operations.md "Environments".

# --- Supabase (Pick8 has its own project, distinct from Who You Got) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key; browser-safe, RLS applies>
SUPABASE_SECRET_KEY=<service-role secret; SERVER ONLY, bypasses RLS>

# --- Who You Got shared football-data API (consumer side) ---
WHO_YOU_GOT_API_URL=https://<who-you-got-host>
WHO_YOU_GOT_API_KEY=<must equal PICK8_SHARED_API_KEY configured in Who You Got>

# --- Cron ---
# Bearer token expected by /api/cron/{sync-fixtures,sync-results,reconcile-results}.
# Also configured in the external scheduler that calls sync-results.
CRON_SECRET=<long random string>

# --- Signup / site ---
PICK8_SIGNUP_CODE=<server-only invite code; never NEXT_PUBLIC_>
# Canonical site URL used in auth emails/redirects. Must match Supabase Auth URL configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional / legacy (not needed for the Pick8 product) ---
# FOOTBALL_DATA_API_KEY=   # legacy WYG football-data.org client only
# FOOTBALL_DATA_TIMEOUT_MS=
# RESEND_API_KEY=          # legacy WYG email code only; Pick8 sends no app email
# REMINDER_EMAIL_FROM=     # legacy WYG email code only
# DEBUG_TIMINGS=1 / DEBUG_CRON=1 / DEBUG_NOTIFICATIONS=1   # verbose diagnostics; never enable in production
# VERCEL_REGION is provided by Vercel and only appears in logs.
