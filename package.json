{
  "name": "pick8",
  "version": "0.1.0",
  "private": true,
  "description": "A private Premier League matchday prediction competition",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "spike:football-data": "node --experimental-strip-types scripts/spike-football-data.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
